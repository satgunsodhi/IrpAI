# IrpAI Environment Configuration
# Copy this file to .env and fill in your values.

# Optional: Set this to authenticate with Hugging Face Hub if needed.
# HF_TOKEN="your_huggingface_token_here"

# Optional: Kaggle integration config
# KAGGLE_USERNAME="your_kaggle_username"
# KAGGLE_KEY="your_kaggle_api_key"

# Optional: GitHub token if pushing notebooks/data dynamically
# GITHUB_TOKEN="your_github_token"
